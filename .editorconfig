# NavEnergy canonical .editorconfig
# Copy this into the root of every new NavEnergy / NTEC project so all editors
# and contributors produce consistent files. See standards/coding-standards.md.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown — trailing whitespace can be a hard line break, do not trim
[*.md]
trim_trailing_whitespace = false

# Python — PEP 8 uses 4 spaces
[*.py]
indent_size = 4

# C# / .NET
[*.cs]
indent_size = 4

# Go uses tabs
[*.go]
indent_style = tab

# Makefiles require tabs
[Makefile]
indent_style = tab

# YAML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Windows batch / PowerShell scripts commonly use CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
